    11. Count total students.
    SELECT COUNT(*) AS total_students FROM text_students;

    12. Find average age.
    SELECT AVG(age) AS average_age FROM text_students;

    13. Find maximum age.
    SELECT MAX(age) AS max_age FROM text_students;

    14. Find minimum age.
    SELECT MIN(age) AS min_age FROM text_students;

    15. Display departments with total students using GROUP BY.
    SELECT department, COUNT(*) AS student_count 
    FROM text_students 
    GROUP BY department;

    16. Display departments having more than two students using HAVING.
    SELECT department, COUNT(*) AS student_count 
    FROM text_students 
    GROUP BY department HAVING COUNT(*) > 2;

